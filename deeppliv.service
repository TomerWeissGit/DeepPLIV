[Unit]
Description=DeepPLIV Genetic IV Simulation - Long Running Execution
Documentation=https://github.com/your-repo/DeepPLIV
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/DeepPLIV

# Environment setup
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/home/ubuntu/DeepPLIV
Environment=PYTHONUNBUFFERED=1

# Main execution command
ExecStart=/usr/bin/python3 aws_genetic_iv_parallel.py execute

# Restart configuration for spot instance resilience
Restart=always
RestartSec=30
StartLimitBurst=10

# Logging configuration
StandardOutput=journal
StandardError=journal
SyslogIdentifier=deeppliv

# Security and resource limits
PrivateTmp=true
NoNewPrivileges=true
LimitNOFILE=65536
LimitNPROC=4096

# Timeouts
TimeoutStartSec=300
TimeoutStopSec=60

# Kill configuration
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target