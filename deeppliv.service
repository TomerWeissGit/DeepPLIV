[Unit]
Description=DeepPLIV Genetic IV Simulation - Long Running Execution
Documentation=https://github.com/your-repo/DeepPLIV
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/DeepPLIV
StandardOutput=append:/var/log/deeppliv-startup.log
StandardError=append:/var/log/deeppliv-startup.log

# Environment setup
Environment=PATH=/home/ubuntu/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/home/ubuntu/DeepPLIV
Environment=PYTHONUNBUFFERED=1

# Threading optimization for 32-core instance with hyperthreading
Environment=OMP_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
Environment=VECLIB_MAXIMUM_THREADS=2
Environment=NUMEXPR_NUM_THREADS=2

# Main execution command
ExecStart=/home/ubuntu/venv/bin/python aws_genetic_iv_parallel.py execute

# Restart configuration for spot instance resilience
Restart=always
RestartSec=30
StartLimitBurst=10

# Logging configuration
StandardOutput=journal
StandardError=journal
SyslogIdentifier=deeppliv

# Security and resource limits
PrivateTmp=true
NoNewPrivileges=true
LimitNOFILE=65536
LimitNPROC=4096

# Timeouts
TimeoutStartSec=300
TimeoutStopSec=60

# Kill configuration
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target